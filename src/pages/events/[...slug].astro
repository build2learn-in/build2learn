---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { render } from 'astro:content';

export async function getStaticPaths() {
  const events = await getCollection('event');

  return events.map((event) => ({
    params: { slug: event.id },
    props: { event },
  }));
}

const { event } = Astro.props;
const { Content } = await render(event);

const formattedDate = event.data.eventDate.toLocaleDateString('en-US', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const formattedDeadline = event.data.registrationDeadline.toLocaleDateString(
  'en-US',
  {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }
);

// Get current date in IST timezone
const now = new Date();
const istTimeString = now.toLocaleString('en-US', { timeZone: 'Asia/Kolkata' });
const istTime = new Date(istTimeString);
const currentDateIST = new Date(
  istTime.getFullYear(),
  istTime.getMonth(),
  istTime.getDate()
);

const eventDate = new Date(event.data.eventDate);
const eventDateIST = new Date(
  eventDate.getFullYear(),
  eventDate.getMonth(),
  eventDate.getDate()
);
const registrationDeadline = new Date(event.data.registrationDeadline);

let status;
if (eventDateIST.getTime() < currentDateIST.getTime()) {
  status = 'PAST';
} else if (eventDateIST.getTime() === currentDateIST.getTime()) {
  status = 'ONGOING';
} else {
  status = 'UPCOMING';
}

const registrationOpen = currentDateIST <= registrationDeadline;

const statusStyles = {
  UPCOMING: 'bg-blue-100 text-blue-700',
  ONGOING: 'bg-red-100 text-red-700',
  PAST: 'bg-indigo-100 text-indigo-700',
};

const statusNote = {
  ONGOING: 'Happening today!',
};
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`${event.data.title} | Build2Learn`}
      description={event.data.description}
      image={event.data.heroImage}
    />
  </head>
  <body>
    <Header />

    <!-- Hero -->
    <div class="relative overflow-hidden isometric-bg" data-status={status}>
      <div class="absolute inset-0 bg-white/40"></div>

      <div
        class="relative mx-auto max-w-6xl px-4 py-12 sm:px-6 md:py-16 lg:px-8"
      >
        <span
          class={`inline-flex items-center gap-2 rounded-full px-3 py-1 text-xs font-semibold uppercase tracking-wider ${
            statusStyles[status]
          }`}
        >
          {
            status === 'ONGOING' && (
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-current" />
            )
          }
          {status}
        </span>

        <h1
          class="mt-4 text-3xl font-bold leading-tight text-gray-900 md:text-5xl"
        >
          {event.data.title}
        </h1>

        <p class="mt-4 max-w-2xl text-lg text-gray-700">
          {event.data.description}
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          <div
            class="inline-flex items-center gap-2.5 rounded-lg border border-gray-200 bg-white/90 px-4 py-2.5 text-sm font-semibold text-gray-800 shadow-sm"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5 shrink-0 text-blue-600"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            {formattedDate}
          </div>

          <div
            class="inline-flex items-center gap-2.5 rounded-lg border border-gray-200 bg-white/90 px-4 py-2.5 text-sm font-semibold text-gray-800 shadow-sm"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5 shrink-0 text-blue-600"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            {event.data.eventTime}
          </div>

          <a
            href={event.data.venue_location}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2.5 rounded-lg border border-gray-200 bg-white/90 px-4 py-2.5 text-sm font-semibold text-gray-800 shadow-sm transition-colors hover:border-blue-300 hover:text-blue-700"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5 shrink-0 text-blue-600"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            {event.data.venue}
          </a>
        </div>
      </div>
    </div>

    <main class="event-main">
      <div class="mx-auto max-w-6xl px-4 pb-16 sm:px-6 lg:px-8">
        <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_320px] lg:gap-12">
          <!-- Content -->
          <article class="min-w-0">
            {
              status === 'UPCOMING' && (
                <div class="mb-10 flex flex-col gap-4 rounded-xl border border-blue-200 bg-blue-50 p-5 sm:flex-row sm:items-center sm:justify-between lg:hidden">
                  <div>
                    <p class="font-semibold text-blue-900">
                      {registrationOpen
                        ? 'Registrations are open'
                        : 'Registration closed'}
                    </p>
                    <p class="mt-0.5 text-sm text-blue-700">
                      {registrationOpen
                        ? `Closes ${formattedDeadline}${
                            event.data.maxParticipants
                              ? ` · ${event.data.maxParticipants} seats`
                              : ''
                          }`
                        : 'The deadline has passed'}
                    </p>
                  </div>
                  {registrationOpen && (
                    <a
                      href={event.data.registration_link}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex shrink-0 items-center justify-center rounded-lg bg-blue-600 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-blue-700"
                    >
                      Register Now
                    </a>
                  )}
                </div>
              )
            }

            <div class="event-content">
              <Content />
            </div>

            {
              event.data.organisers && event.data.organisers.length > 0 && (
                <section class="mt-14">
                  <h2 class="mb-6 text-2xl font-bold text-gray-900">
                    Event Organizers
                  </h2>
                  <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
                    {event.data.organisers.map((organiser) => (
                      <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
                        <div class="mb-4 flex items-center">
                          <img
                            src={organiser.photo || '/default-avatar.jpg'}
                            alt={organiser.name}
                            class="mr-4 h-16 w-16 rounded-full object-cover"
                          />
                          <div>
                            <h3 class="text-lg font-semibold text-gray-900">
                              {organiser.name}
                            </h3>
                            {organiser.role && (
                              <p class="text-gray-600">{organiser.role}</p>
                            )}
                          </div>
                        </div>
                        {organiser.social && (
                          <div class="flex gap-4">
                            {organiser.social.linkedin && (
                              <a
                                href={organiser.social.linkedin}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="text-gray-600 hover:text-blue-600"
                              >
                                <svg
                                  class="h-5 w-5"
                                  fill="currentColor"
                                  viewBox="0 0 24 24"
                                >
                                  <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
                                </svg>
                              </a>
                            )}
                            {organiser.social.twitter && (
                              <a
                                href={organiser.social.twitter}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="text-gray-600 hover:text-blue-400"
                              >
                                <svg
                                  class="h-5 w-5"
                                  fill="currentColor"
                                  viewBox="0 0 24 24"
                                >
                                  <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z" />
                                </svg>
                              </a>
                            )}
                            {organiser.social.github && (
                              <a
                                href={organiser.social.github}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="text-gray-600 hover:text-gray-900"
                              >
                                <svg
                                  class="h-5 w-5"
                                  fill="currentColor"
                                  viewBox="0 0 24 24"
                                >
                                  <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
                                </svg>
                              </a>
                            )}
                            {organiser.social.website && (
                              <a
                                href={organiser.social.website}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="text-gray-600 hover:text-green-600"
                              >
                                <svg
                                  class="h-5 w-5"
                                  fill="none"
                                  stroke="currentColor"
                                  viewBox="0 0 24 24"
                                >
                                  <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"
                                  />
                                </svg>
                              </a>
                            )}
                          </div>
                        )}
                      </div>
                    ))}
                  </div>
                </section>
              )
            }
          </article>

          <!-- Sidebar -->
          <aside
            class="mt-12 space-y-6 lg:sticky lg:top-24 lg:mt-0 lg:self-start"
          >
            {
              status === 'ONGOING' && (
                <p class="rounded-xl bg-red-50 px-5 py-4 text-sm font-medium text-red-700">
                  {statusNote[status]}
                </p>
              )
            }

            {
              status === 'UPCOMING' && registrationOpen && (
                <div class="hidden rounded-2xl bg-blue-600 p-6 text-white shadow-lg shadow-blue-600/25 lg:block">
                  <p class="text-xs font-semibold uppercase tracking-wider text-blue-100">
                    Registration
                  </p>
                  <div class="mt-4 space-y-3 text-sm">
                    <div class="flex items-center justify-between gap-4">
                      <span class="text-blue-100">Closes on</span>
                      <span class="font-semibold">{formattedDeadline}</span>
                    </div>
                    {event.data.maxParticipants && (
                      <div class="flex items-center justify-between gap-4">
                        <span class="text-blue-100">Seats</span>
                        <span class="font-semibold">
                          {event.data.maxParticipants}
                        </span>
                      </div>
                    )}
                  </div>
                  <a
                    href={event.data.registration_link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="mt-6 inline-flex w-full items-center justify-center rounded-lg bg-white px-4 py-2.5 text-sm font-semibold text-blue-700 transition-colors hover:bg-blue-50"
                  >
                    Register Now
                  </a>
                </div>
              )
            }

            {
              status === 'UPCOMING' && !registrationOpen && (
                <div class="hidden rounded-2xl border border-gray-200 bg-gray-50 p-6 lg:block">
                  <p class="text-xs font-semibold uppercase tracking-wider text-gray-500">
                    Registration
                  </p>
                  <p class="mt-4 text-sm font-medium text-gray-600">
                    Registration closed on {formattedDeadline}.
                  </p>
                </div>
              )
            }

            <section
              class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm"
            >
              <h2
                class="border-b border-gray-100 px-6 py-4 text-xs font-semibold uppercase tracking-wider text-gray-500"
              >
                Event Details
              </h2>

              <dl class="space-y-5 px-6 py-6">
                <div>
                  <dt
                    class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-gray-400"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="h-4 w-4"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <rect x="3" y="4" width="18" height="18" rx="2" ry="2">
                      </rect>
                      <line x1="16" y1="2" x2="16" y2="6"></line>
                      <line x1="8" y1="2" x2="8" y2="6"></line>
                      <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                    Date
                  </dt>
                  <dd class="mt-1.5 pl-6 text-sm font-medium text-gray-900">
                    {formattedDate}
                  </dd>
                </div>

                <div>
                  <dt
                    class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-gray-400"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="h-4 w-4"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <circle cx="12" cy="12" r="10"></circle>
                      <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                    Time
                  </dt>
                  <dd class="mt-1.5 pl-6 text-sm font-medium text-gray-900">
                    {event.data.eventTime} IST
                  </dd>
                </div>

                <div>
                  <dt
                    class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-gray-400"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="h-4 w-4"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z">
                      </path>
                      <circle cx="12" cy="10" r="3"></circle>
                    </svg>
                    Venue
                  </dt>
                  <dd class="mt-1.5 pl-6 text-sm font-medium text-gray-900">
                    {event.data.venue}
                    <p class="mt-1 font-normal leading-relaxed text-gray-500">
                      {event.data.venue_address}
                    </p>
                  </dd>
                </div>
              </dl>

              <a
                href={event.data.venue_location}
                target="_blank"
                rel="noopener noreferrer"
                class="block border-t border-gray-100 px-6 py-3.5 text-sm font-semibold text-blue-600 transition-colors hover:bg-blue-50"
              >
                View on Google Maps →
              </a>
            </section>
          </aside>
        </div>
      </div>
    </main>
    <Footer />
  </body>
</html>

<style>
  /* Override global page styles that fight this layout */
  .event-main {
    max-width: none;
    margin: 0;
    padding: 0;
  }

  /* Markdown content typography */
  .event-content {
    max-width: 68ch;
  }

  .event-content :global(h2) {
    margin: 2.75rem 0 1rem;
    font-size: 1.75em;
  }

  .event-content :global(h3) {
    margin: 2rem 0 0.75rem;
    font-size: 1.3em;
  }

  .event-content :global(h2:first-child) {
    margin-top: 0;
  }

  .event-content :global(p) {
    margin: 0 0 1.25em;
  }

  .event-content :global(ul),
  .event-content :global(ol) {
    margin: 0 0 1.5em;
    padding-left: 1.625em;
  }

  .event-content :global(ul) {
    list-style: disc;
  }

  .event-content :global(ol) {
    list-style: decimal;
  }

  .event-content :global(li) {
    margin-bottom: 0.5em;
  }

  .event-content :global(blockquote) {
    margin: 1.75em 0;
    padding: 1em 1.25em;
    border: 0;
    border-radius: 0.75rem;
    background-color: #eef2ff;
    color: #3730a3;
    font-size: 1.1em;
  }

  /* Spacing hacks in the markdown source */
  .event-content :global(br) {
    display: none;
  }
</style>

<style>
  .isometric-bg {
    opacity: 0.9;
  }

  .isometric-bg[data-status='UPCOMING'] {
    background-color: #e8f0ff;
    background-image:
      radial-gradient(#444cf7 0.5px, transparent 0.5px),
      radial-gradient(#444cf7 0.5px, #e8f0ff 0.5px);
    background-size: 20px 20px;
    background-position:
      0 0,
      10px 10px;
  }

  .isometric-bg[data-status='ONGOING'] {
    background-color: #ffe8e8;
    background-image:
      radial-gradient(#ef4444 0.5px, transparent 0.5px),
      radial-gradient(#ef4444 0.5px, #ffe8e8 0.5px);
    background-size: 20px 20px;
    background-position:
      0 0,
      10px 10px;
  }

  .isometric-bg[data-status='PAST'] {
    background-color: #f0f0ff;
    background-image:
      radial-gradient(#8b8cf7 0.5px, transparent 0.5px),
      radial-gradient(#8b8cf7 0.5px, #f0f0ff 0.5px);
    background-size: 20px 20px;
    background-position:
      0 0,
      10px 10px;
  }
</style>
